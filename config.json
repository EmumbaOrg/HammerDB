{
  "database": {
    "host": "localhost",
    "username": "postgres",
    "password": "password",
    "db_name": "ann",
    "instance_type": "local-laptop",
    "provider": "local",
    "enable_seqscan": "off"
  },
  "hammerdb": {
    "db": "pg",
    "bm": "TPC-C",
    "build_schema": true,
    "pg_driver": "timed",
    "pg_total_iterations": "10000000",
    "pg_count_ware": "5",
    "pg_num_vu": "3",
    "pg_rampup": "0",
    "pg_duration": "2",
    "pg_allwarehouse": "false",
    "pg_timeprofile": "true",
    "pg_vacuum": "false",
    "keepalive_margin": "90"
  },
  "monitoring": {
    "cache": {
      "enabled": true,
      "interval_seconds": 5
    }
  },
  "cases": [
    {
      "db-label": "hnsw-bq-mixed-test-buffercache-debugging-time",  
      "vindex": "hnsw_bq",
      "vector_table_name": "public.vdbbench_table_test",
      "drop_old": true,
      "load": true,
      "search-serial": false,
      "search-concurrent": false,
      "case-type": "Performance1536D50K",
      "maintenance-work-mem": "8GB",
      "max-parallel-workers": 7,
      "ef-search": [128],
      "ef-construction": 64,
      "m": 16,
      "quantization-type": "bit",
      "reranking": "true",
      "quantized-fetch-limit": 128,
      "dim": 1536,
      "rerank-distance-op": "hamming",
      "num-concurrency": ["20", "26"],
      "mw_vector_vu": "8",
      "mw_oltp_vu": "12",
      "concurrency-duration": 30,
      "k": 10,
      "run_count": 1
    }
  ]
}
